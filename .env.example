# 仅演示。应用不会隐式加载此文件；请显式 export 或由部署系统注入。
FKB_APP_ENV=development
FKB_AUTH_MODE=demo
FKB_RETRIEVAL_MODE=wiki
FKB_LLM_PROVIDER=http
FKB_WIKI_QUERY_STRATEGY=universal
FKB_COOKIE_SECURE=false
FKB_AUTO_CREATE_SCHEMA=true
FKB_SCAN_BACKEND=basic
# 留空时，数据存储到本项目 data/，数据库使用独立 SQLite。
# FKB_STORAGE_DIR=/absolute/path/to/this-project/data
# FKB_DATABASE_URL=sqlite:////absolute/path/to/this-project/data/fund_kb.sqlite3
# 需要网页加密保存模型密钥时，生成本项目自己的32字节Fernet密钥并由环境注入。
# FKB_PROVIDER_MASTER_KEY=YOUR_OWN_FERNET_KEY
