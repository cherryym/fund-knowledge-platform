{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "基金运营答疑与解决方案结果 v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "status", "mode", "summary", "scope", "facts", "missing_facts", "claims", "citations", "solution", "limitations", "required_sources", "review_status", "generated_at"],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["ANSWERED", "NEEDS_CLARIFICATION", "INSUFFICIENT_EVIDENCE", "CONFLICT", "OUT_OF_SCOPE"]},
    "mode": {"enum": ["answer", "solution"]},
    "summary": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "missing_facts": {"type": "array", "items": {"$ref": "#/$defs/missing"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "solution": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/solution"}]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "required_sources": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["MACHINE_CHECKED", "EXPERT_REVIEWED", "REQUIRES_EXPERT"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "format": {"enum": ["wiki_markdown"]},
    "narrative_markdown": {"type": "string", "minLength": 1},
    "server_notice": {"type": "string", "minLength": 1},
    "grounding_status": {"enum": ["SOURCE_LINKED", "UNVERIFIED", "NO_LOCAL_SOURCES"]},
    "quality_warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
    "analysis": {"$ref": "#/$defs/analysis"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "ANSWERED"}}, "not": {"required": ["format"]}}, "then": {"properties": {"claims": {"minItems": 1}, "citations": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "ANSWERED"}, "mode": {"const": "solution"}}, "not": {"required": ["format"]}}, "then": {"properties": {"solution": {"$ref": "#/$defs/solution"}}}},
    {"if": {"required": ["format"]}, "then": {"required": ["narrative_markdown", "grounding_status", "quality_warnings"],
      "properties": {"review_status": {"const": "REQUIRES_EXPERT"}, "solution": {"type": "null"}, "claims": {"maxItems": 0}}}},
    {"if": {"required": ["format", "grounding_status"], "properties": {"grounding_status": {"const": "SOURCE_LINKED"}}}, "then": {"properties": {"citations": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "NEEDS_CLARIFICATION"}}}, "then": {"properties": {"missing_facts": {"minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "INSUFFICIENT_EVIDENCE"}}, "not": {"required": ["format"]}}, "then": {"properties": {"required_sources": {"minItems": 1}}}}
  ],
  "$defs": {
    "analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["interpretation", "checks", "branches"],
      "properties": {
        "interpretation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "checks": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["title", "reason", "evidence_ids"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 80},
            "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
            "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}}
          }
        }},
        "branches": {"type": "array", "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["condition", "action", "evidence_ids"],
          "properties": {
            "condition": {"type": "string", "minLength": 1, "maxLength": 2000},
            "action": {"type": "string", "minLength": 1, "maxLength": 2000},
            "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}}
          }
        }}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "origin", "certainty"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "origin": {"enum": ["USER", "DOCUMENT", "KNOWLEDGE", "CALCULATION"]},
        "certainty": {"enum": ["PROVIDED", "VERIFIED", "UNCERTAIN"]}
      }
    },
    "missing": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "question", "why_needed"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "why_needed": {"type": "string", "minLength": 1}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resource_id", "version_id", "block_id", "source_title", "excerpt", "locator", "content_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "resource_id": {"type": "string", "format": "uuid"},
        "version_id": {"type": "string", "format": "uuid"},
        "block_id": {"type": "string", "format": "uuid"},
        "source_title": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1},
        "locator": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string"}, "source_page": {"type": "integer", "minimum": 1}, "sheet": {"type": "string"}, "cell": {"type": "string"}}},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "solution": {
      "type": "object", "additionalProperties": false,
      "required": ["goal", "preconditions", "materials", "steps", "branches", "completion_checks", "escalation"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "materials": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "branches": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["condition", "action"], "properties": {"condition": {"type": "string"}, "action": {"type": "string"}}}},
        "completion_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "escalation": {"type": "array", "items": {"type": "string"}}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "owner_role", "inputs", "output", "verification", "evidence_ids", "depends_on"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "owner_role": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "output": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
