# 模板，不自动加载。空值须由部署系统/秘密管理器显式提供。
FKB_APP_ENV=production
FKB_DATABASE_URL=
FKB_STORAGE_DIR=/srv/fund-kb/data
FKB_AUTO_CREATE_SCHEMA=false
FKB_AUTH_MODE=oidc
FKB_OIDC_ISSUER=
FKB_OIDC_CLIENT_ID=
FKB_OIDC_CLIENT_SECRET=
FKB_DEPLOYMENT_ADMIN_SUBJECTS=[]
FKB_COOKIE_SECURE=true
FKB_ALLOWED_ORIGINS=["https://kb.example.com"]
FKB_SCAN_BACKEND=clamav
FKB_CLAMAV_COMMAND=clamscan
FKB_STORAGE_BACKEND=local
FKB_JOB_BACKEND=celery
FKB_CELERY_BROKER_URL=
FKB_LLM_PROVIDER=http
FKB_WIKI_QUERY_STRATEGY=universal
FKB_PROVIDER_MASTER_KEY=
# Wiki-only生产配置示例；混合检索按docs/retrieval.md显式增加配置。
FKB_RETRIEVAL_MODE=wiki
